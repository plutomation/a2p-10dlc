    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const store = $getWorkflowStaticData('global');\nif (!store.processed) store.processed = {};\nstore.processed[$json.dedupeKey] = { at: new Date().toISOString(), from: $json.From, to: $json.To };\nreturn [{ json: $json }];"
      },
