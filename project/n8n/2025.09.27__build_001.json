    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const src = ($json.body && typeof $json.body === 'object' && Object.keys($json.body).length) ? $json.body : $json;\nconst from = (src.From || '').trim();\nconst to = (src.To || '').trim();\nconst text = (src.Body || '').trim();\nconst rawSid = (src.MessageSid || src.SmsMessageSid || src.SmsSid || '').toString().trim();\nconst sid = rawSid.toUpperCase().replace(/[^A-Z0-9]/g, '');\nconst sidValid = /^SM[A-F0-9]{32}$/.test(sid);\nconst numMedia = parseInt(src.NumMedia || '0', 10) || 0;\nconst media = [];\nfor (let i = 0; i < numMedia; i++) { const u = src[`MediaUrl${i}`]; if (u) media.push(u); }\nconst received = new Date().toISOString();\nlet note = `**Inbound SMS**\\n\\n**From:** ${from}\\n**To:** ${to}\\n**MessageSid:** ${sid || rawSid}\\n**Received:** ${received}\\n\\n**Body:**\\n${text || \"_(empty)\"}\\n`;\nif (media.length) { note += `\\n**Media (${media.length}):**\\n` + media.map((m, i) => `- [Media ${i+1}](${m})`).join('\\n'); }\nfunction djb2(str){let h=5381;for(let i=0;i<str.length;i++)h=((h<<5)+h)+str.charCodeAt(i);return (h>>>0).toString(16).toUpperCase();}\nconst fallback = `FALLBACK-${djb2(JSON.stringify({From:from,To:to,Body:text,NumMedia:numMedia}))}`;\nconst dedupeKey = sid ? sid : fallback;\nreturn [{ json: { ...$json, ...src, from, to, text, sid, sidValid, dedupeKey, media, hasMedia: media.length>0, received, noteBody: note } }];"
      },
      "id": "Code_Normalize",
      "name": "Code: Normalize + Dedupe Key",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -520,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const store = $getWorkflowStaticData('global');\nif (!store.processed) store.processed = {};\nconst key = $json.dedupeKey;\nconst duplicate = !!store.processed[key];\nreturn [{ json: { ...$json, duplicate } }];"
      },
      "id": "Code_CheckDup",
      "name": "Code: Check Duplicate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -300,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.duplicate}}"
            }
          ]
        }
      },
      "id": "IF_Duplicate",
      "name": "IF: Duplicate?",
      "type": "n8n-nodes-base.if",
